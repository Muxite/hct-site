# HCT site frontend — Supabase read access (publishable key only; safe in browser).
# Copy to .env and fill in. The backend writes with the SECRET key; the browser
# only ever reads under RLS with the publishable key.
VITE_SB_URL=https://YOUR-PROJECT.supabase.co
VITE_SB_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Local screenshot/QA use only — DO NOT set in Vercel/production env.
# Forces AdminContext's isAdmin/editMode to true with no real Supabase Auth
# session, so `npm run dev` shows the admin editing UI (pencils on Home/
# People/Project/Paper pages) before any admin account exists to sign in
# with. A visible "ADMIN PREVIEW" banner appears whenever this is active
# (see components/AdminPreviewBanner.jsx), so a screenshot can't be mistaken
# for a real logged-in session.
#
# Inert everywhere else by construction, not just by convention: it only
# takes effect when import.meta.env.DEV is also true (see lib/adminPreview.js),
# and Vite's `DEV` is false in any `vite build` output (production builds set
# NODE_ENV=production regardless of --mode), so leaving this set here has no
# effect on a real deployed build even if it somehow shipped.
# VITE_ADMIN_PREVIEW=1
